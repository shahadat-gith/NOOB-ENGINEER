# Server
PORT=3000
NODE_ENV=development

# MongoDB - the part after the last slash is the database name
MONGODB_URI=mongodb://localhost:27017/main_db

# Single admin account (no Admin model/table) - POST /api/admin/login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# JWT - use a long random secret in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin - OAuth callbacks redirect here with ?token=...
FRONTEND_URL=http://localhost:3001

# OAuth callback URLs - full URLs, must EXACTLY match the provider consoles:
#   Google:  http://localhost:3000/auth/google/callback
#            https://api.noobengineer.in/auth/google/callback
#   GitHub:  http://localhost:3000/auth/github/callback
#            https://api.noobengineer.in/auth/github/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Google OAuth - https://console.cloud.google.com/apis/credentials
# Register GOOGLE_CALLBACK_URL as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth - https://github.com/settings/developers
# Register GITHUB_CALLBACK_URL as the Authorization callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
